static int64_t nrWindowPaletteOkCube(int64_t value) {
    return (value * value / NR_WINDOW_PALETTE_OK_Q) * value / NR_WINDOW_PALETTE_OK_Q;
}

static int32_t nrWindowPaletteOkModulo(int64_t value, int32_t divisor) {
    int32_t result = (int32_t)(value % divisor);
    return result < 0 ? result + divisor : result;
}

static int32_t nrWindowPaletteOkSine(int64_t phase) {
    return SINE[nrWindowPaletteOkModulo(phase, 1024)];
}

static void nrWindowPaletteOkLinear(int32_t lightness, int32_t chroma, int32_t hue,
                                    int64_t rgb[3]) {
    int64_t L = (int64_t)lightness * NR_WINDOW_PALETTE_OK_Q / 1000;
    int64_t C = (int64_t)chroma * NR_WINDOW_PALETTE_OK_Q / 10000;
    int32_t phase = (int32_t)((int64_t)nrWindowPaletteOkModulo(hue, 360000) * 1024 / 360000);
    int64_t a = C * nrWindowPaletteOkSine(phase + 256) / 1000;
    int64_t b = C * nrWindowPaletteOkSine(phase) / 1000;
    int64_t l = nrWindowPaletteOkCube(L + (396338 * a + 215804 * b) / 1000000);
    int64_t m = nrWindowPaletteOkCube(L - (105561 * a + 63854 * b) / 1000000);
    int64_t s = nrWindowPaletteOkCube(L - (89484 * a + 1291486 * b) / 1000000);
    rgb[0] = (4076742 * l - 3307712 * m + 230970 * s) / 1000000;
    rgb[1] = (-1268438 * l + 2609757 * m - 341319 * s) / 1000000;
    rgb[2] = (-4196 * l - 703419 * m + 1707615 * s) / 1000000;
}

static int nrWindowPaletteOkInGamut(const int64_t rgb[3]) {
    return rgb[0] >= 0 && rgb[0] <= NR_WINDOW_PALETTE_OK_Q &&
           rgb[1] >= 0 && rgb[1] <= NR_WINDOW_PALETTE_OK_Q &&
           rgb[2] >= 0 && rgb[2] <= NR_WINDOW_PALETTE_OK_Q;
}

static int32_t nrWindowPaletteOkGamma(int64_t value) {
    int low = 0, high = 255;
    while (low < high) {
        int middle = (low + high) / 2;
        if (value > OK_BOUNDARY[middle]) low = middle + 1;
        else high = middle;
    }
    return low;
}

static uint32_t nrWindowPaletteOkPack(int32_t red, int32_t green, int32_t blue) {
    if (red < 0) red = 0;
    else if (red > 255) red = 255;
    if (green < 0) green = 0;
    else if (green > 255) green = 255;
    if (blue < 0) blue = 0;
    else if (blue > 255) blue = 255;
    return (uint32_t)red << 16 | (uint32_t)green << 8 | (uint32_t)blue;
}

static uint32_t nrWindowPaletteSourceOklch(int32_t lightness, int32_t chroma, int32_t hue) {
    if (lightness < 0 || lightness > 1000 || chroma < 0 || chroma > 4000)
        return 0xffffffffu;
    if (!lightness) return 0;
    if (lightness == 1000) return 0xffffffu;
    int64_t rgb[3];
    nrWindowPaletteOkLinear(lightness, chroma, hue, rgb);
    if (!nrWindowPaletteOkInGamut(rgb)) {
        int low = 0, high = chroma;
        for (int i = 0; i < 14 && low < high; ++i) {
            int middle = (low + high + 1) / 2;
            nrWindowPaletteOkLinear(lightness, middle, hue, rgb);
            if (nrWindowPaletteOkInGamut(rgb)) low = middle;
            else high = middle - 1;
        }
        nrWindowPaletteOkLinear(lightness, low, hue, rgb);
    }
    return nrWindowPaletteOkPack(nrWindowPaletteOkGamma(rgb[0]),
                                 nrWindowPaletteOkGamma(rgb[1]),
                                 nrWindowPaletteOkGamma(rgb[2]));
}
